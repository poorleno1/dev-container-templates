# Environment Variables Template for Claude Code MCP Servers
#
# Instructions:
# 1. Copy this file to .env: cp .env.template .env
# 2. Fill in your actual values (replace the placeholder text)
# 3. NEVER commit .env to Git (it's already in .gitignore)
#
# These variables are used by MCP servers configured in .claude/mcp.json

# ============================================================================
# Terraform MCP Server Configuration
# ============================================================================

# HCP Terraform (Terraform Cloud) or Terraform Enterprise base URL
# Default: https://app.terraform.io
# For Terraform Enterprise, use your organization's URL (e.g., https://terraform.mycompany.com)
TFE_ADDRESS=https://app.terraform.io

# HCP Terraform API token for authentication
# Get your token from: https://app.terraform.io/app/settings/tokens
# IMPORTANT: Keep this secret - never commit to repository
TFE_TOKEN=

# Enable Terraform operations that modify infrastructure (apply, destroy)
# Valid values: "true" or "false"
# RECOMMENDED: Keep as "false" for safety - only enable when explicitly needed
# When "false": Claude can read state and plan, but cannot apply changes
# When "true": Claude can execute terraform apply and destroy (with approval)
ENABLE_TF_OPERATIONS=false

# ============================================================================
# Additional MCP Server Variables (Add as needed)
# ============================================================================

# GitHub Personal Access Token (if you add GitHub MCP server)
# GITHUB_TOKEN=

# Azure Service Principal (if you add Azure MCP server)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=

